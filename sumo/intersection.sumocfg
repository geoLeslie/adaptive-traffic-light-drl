<?xml version="1.0" encoding="UTF-8"?>
<!-- Episode: 1 s steps, 1800 s of arrivals + up to 600 s clearance = 2400 s. -->
<configuration>
    <input>
        <net-file value="network/intersection.net.xml"/>
        <route-files value="routes/balanced.rou.xml"/>
        <gui-settings-file value="gui.view.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="2400"/>
        <step-length value="1"/>
    </time>
    <processing>
        <!-- Never teleport stuck vehicles: congestion must stay visible in the metrics. -->
        <time-to-teleport value="-1"/>
    </processing>
    <random_number>
        <seed value="42"/>
    </random_number>
    <report>
        <no-step-log value="true"/>
    </report>
</configuration>
